import cv2
import numpy as np
import matplotlib.pyplot as plt
import os

IMG_DIR = "/home/ho/INHA/ML/gray/04/image_0"

img1_path = os.path.join(IMG_DIR, "000000.png")
img2_path = os.path.join(IMG_DIR, "000001.png")

print("Image1:", img1_path)
print("Image2:", img2_path)

img1 = cv2.imread(img1_path, cv2.IMREAD_GRAYSCALE)
img2 = cv2.imread(img2_path, cv2.IMREAD_GRAYSCALE)

if img1 is None:
    raise FileNotFoundError(f"Failed to load {img1_path}")
if img2 is None:
    raise FileNotFoundError(f"Failed to load {img2_path}")

orb = cv2.ORB_create(2000)

kp1, des1 = orb.detectAndCompute(img1, None)
kp2, des2 = orb.detectAndCompute(img2, None)

img1_kp = cv2.drawKeypoints(img1, kp1, None, color=(0,255,0), flags=0)

plt.figure(figsize=(12,4))
plt.imshow(img1_kp, cmap='gray')
plt.title("ORB Keypoints (000000.png)")
plt.axis('off')
plt.savefig("keypoints_04_000000.png", dpi=200)
plt.close()

bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=True)
matches = bf.match(des1, des2)
matches = sorted(matches, key=lambda x: x.distance)[:100]

match_vis = cv2.drawMatches(img1, kp1, img2, kp2, matches, None,
                            flags=cv2.DrawMatchesFlags_NOT_DRAW_SINGLE_POINTS)

plt.figure(figsize=(16,6))
plt.imshow(match_vis)
plt.title("Feature Matches (000000 ↔ 000001)")
plt.axis('off')
plt.savefig("matches_04_000000_000001.png", dpi=200)
plt.close()

print("Saved keypoint & match visualizations.")
